---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { getUi } from "../text/ui";
import "../styles/global.scss";

const { lang, pageTitle, pageDescription = "", page = "" } = Astro.props;
const t = getUi(lang);
const title = pageTitle ? `${pageTitle} | ${t.siteName}` : t.siteName;
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    {pageDescription && <meta name="description" content={pageDescription} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <Header lang={lang} page={page} t={t} currentPath={Astro.url.pathname} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} t={t} />
    <script is:inline>
      document.querySelectorAll("a[href]").forEach((link) => {
        try {
          const url = new URL(link.getAttribute("href"), window.location.href);
          const isWebLink = url.protocol === "http:" || url.protocol === "https:";
          const isExternal = isWebLink && url.origin !== window.location.origin;
          const isPdf = url.pathname.toLowerCase().endsWith(".pdf");

          if (isExternal || isPdf) {
            link.target = "_blank";
            link.relList.add("noopener", "noreferrer");
          }
        } catch {
          // Ignore unusual links that cannot be parsed as URLs.
        }
      });
    </script>
  </body>
</html>
