---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/Hero.astro";
import { getUpcomingDiscoverLifeDates } from "../../data/discoverLife";
import { getLangStaticPaths } from "../../utils/langHelpers";
import { getUi } from "../../text/ui";

export const prerender = true;

export async function getStaticPaths() {
  return getLangStaticPaths();
}

const lang = Astro.params.lang;
const t = getUi(lang);
const supportingImage = "/images/hands-together.webp";
const discoverLifeEvents = await getUpcomingDiscoverLifeDates(lang);
---

<BaseLayout lang={lang} pageTitle={t.pages.home} page="home">
  <Hero lang={lang} t={t} />

  <section class="home-section">
    <div class="container home-intro">
      <h2>{t.home.introTitle}</h2>
      <p>{t.home.introText}</p>
      <div class="event-list compact-list">
        {discoverLifeEvents.map((event) => (
          <a href={`/${lang}/discover-life/?date=${event.date}`}>
            <img src={supportingImage} alt="" />
            <span>
              <strong>Discover Life</strong>
              <small>{event.label} {event.time}</small>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="container home-discover">
    <div>
      <p class="ghost-word">Discover life</p>
      <h2>{t.home.discoverTitle}</h2>
      <p>{t.home.discoverText}</p>
      <a class="btn-main btn-gold" href={`/${lang}/about`}>{t.home.readMore}</a>
    </div>
    <img src={supportingImage} alt="" />
  </section>
</BaseLayout>
