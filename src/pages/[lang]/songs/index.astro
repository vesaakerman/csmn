---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import CatalogBrowser from "../../../components/CatalogBrowser.jsx";
import { getCatalogItems } from "../../../utils/catalog";
import { getLangStaticPaths } from "../../../utils/langHelpers";
import { getUi } from "../../../text/ui";

export const prerender = true;

export async function getStaticPaths() {
  return getLangStaticPaths();
}

const lang = Astro.params.lang;
const t = getUi(lang);
const items = await getCatalogItems(lang, "song");
---

<BaseLayout lang={lang} pageTitle={t.pages.songs} page="songs">
  <section class="catalog-hero">
    <div class="container">
      <h1>{t.media.songCatalogTitle}</h1>
      <p>{t.media.songCatalogIntro}</p>
    </div>
  </section>
  <section class="catalog-section">
    <div class="container">
      <CatalogBrowser items={items} labels={t.media} initialKind="song" client:load />
    </div>
  </section>
</BaseLayout>
