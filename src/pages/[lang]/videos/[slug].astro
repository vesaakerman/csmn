---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import VideoEmbed from "../../../components/VideoEmbed.astro";
import { getCatalogStaticPaths } from "../../../utils/catalog";
import { getUi, languages } from "../../../text/ui";

export const prerender = true;

export async function getStaticPaths() {
  return getCatalogStaticPaths("video", languages);
}

const { item } = Astro.props;
const lang = Astro.params.lang;
const t = getUi(lang);
---

<BaseLayout lang={lang} pageTitle={item.title} page="videos">
  <article class="detail-page container">
    <a class="back-link" href={`/${lang}/videos`}>{t.media.backToVideos}</a>
    <h1>{item.title}</h1>
    <VideoEmbed url={item.videoUrl} title={item.title} />
    {item.displayDescription && (
      <div class="detail-copy">
        <p class="detail-lead">{item.displayDescription}</p>
      </div>
    )}
  </article>
</BaseLayout>
