---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import VideoEmbed from "../../../components/VideoEmbed.astro";
import { getCatalogStaticPaths } from "../../../utils/catalog";
import { formatDate } from "../../../utils/langHelpers";
import { getUi, languages } from "../../../text/ui";

export const prerender = true;

export async function getStaticPaths() {
  return getCatalogStaticPaths("video", languages);
}

const { item } = Astro.props;
const lang = Astro.params.lang;
const t = getUi(lang);
---

<BaseLayout lang={lang} pageTitle={item.title} page="videos">
  <article class="detail-page container">
    <a class="back-link" href={`/${lang}/videos`}>{t.media.backToVideos}</a>
    <h1>{item.title}</h1>
    <VideoEmbed url={item.videoUrl} title={item.title} externalLabel={t.media.openVideo} />
    <div class="detail-grid">
      <div>
        {item.description && <p class="detail-lead">{item.description}</p>}
      </div>
      {(item.languageLabel || item.tags.length || item.submittedBy || item.publishedAt) && (
        <aside class="detail-meta">
          {item.languageLabel && <p><strong>{t.nav.language}</strong><span>{item.languageLabel}</span></p>}
          {!!item.tags.length && <p><strong>{t.media.tags}</strong><span>{item.tags.join(", ")}</span></p>}
          {item.submittedBy && <p><strong>{t.media.submittedBy}</strong><span>{item.submittedBy}</span></p>}
          {item.publishedAt && <p><strong>{t.media.published}</strong><span>{formatDate(item.publishedAt, lang)}</span></p>}
        </aside>
      )}
    </div>
  </article>
</BaseLayout>
