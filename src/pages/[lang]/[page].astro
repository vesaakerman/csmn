---
import BaseLayout from "../../layouts/BaseLayout.astro";
import DiscoverLifeDatesList from "../../components/DiscoverLifeDatesList.astro";
import DiscoverLifeEvent from "../../components/DiscoverLifeEvent.astro";
import MarkdownPanel from "../../components/MarkdownPanel.astro";
import PageHero from "../../components/PageHero.astro";
import { getStaticPagePaths, loadMarkdown } from "../../utils/langHelpers";
import { getUi } from "../../text/ui";

export const prerender = true;

export async function getStaticPaths() {
  return getStaticPagePaths(["events", "fellowship", "discover-life", "resources", "about", "donate"]);
}

const lang = Astro.params.lang;
const page = Astro.params.page;
const t = getUi(lang);
const Content = await loadMarkdown(lang, page);
const pageTitle = t.pages[page] || t.siteName;
const pageHeroImages = {
  events: "/images/group.webp",
  fellowship: "/images/group-of-three.webp",
  resources: "/images/team.webp",
};
const heroImage = pageHeroImages[page] || "/images/hands-together.webp";
---

<BaseLayout lang={lang} pageTitle={pageTitle} page={page}>
  {page === "discover-life" ? (
    <div class="container page-body">
      <DiscoverLifeEvent lang={lang} />
    </div>
  ) : (
    <>
      <PageHero image={heroImage} />
      <div class="container page-body">
        <MarkdownPanel Content={Content} />
        {page === "events" && <DiscoverLifeDatesList lang={lang} />}
      </div>
    </>
  )}
</BaseLayout>
