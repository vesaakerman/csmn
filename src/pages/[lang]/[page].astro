---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CatalogBrowser from "../../components/CatalogBrowser.jsx";
import MarkdownPanel from "../../components/MarkdownPanel.astro";
import PageHero from "../../components/PageHero.astro";
import { getCatalogItems } from "../../utils/catalog";
import { getStaticPagePaths, loadMarkdown } from "../../utils/langHelpers";
import { getUi } from "../../text/ui";

export const prerender = true;

export async function getStaticPaths() {
  return getStaticPagePaths(["events", "fellowship", "discover-life", "resources", "about", "donate"]);
}

const lang = Astro.params.lang;
const page = Astro.params.page;
const t = getUi(lang);
const Content = await loadMarkdown(lang, page);
const catalogItems = page === "resources" ? await getCatalogItems(lang) : [];
const pageTitle = t.pages[page] || t.siteName;
const heroImage = page === "about" || page === "events" || page === "fellowship" ? "/images/hero-group.jpg" : "/images/study.jpg";
---

<BaseLayout lang={lang} pageTitle={pageTitle} page={page}>
  <PageHero title={pageTitle} image={heroImage} />
  <div class="container page-body">
    <MarkdownPanel Content={Content} />
  </div>

  {page === "resources" && (
    <section class="catalog-section">
      <div class="container">
        <CatalogBrowser items={catalogItems} labels={t.media} initialKind="all" client:load />
      </div>
    </section>
  )}
</BaseLayout>
